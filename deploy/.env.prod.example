# ════════════════════════════════════════════════════════════════════════
# RAIL-BLOC — production .env template (Oracle VM)
# cp deploy/.env.prod.example .env  →  phir har 🔧 fill karo
# ════════════════════════════════════════════════════════════════════════

# ── Domain (Caddy auto-HTTPS iss naam pe certificate lega) ──────────────
# DuckDNS pe YEHI naam register karna (Step 2 of DEPLOYMENT.md)
CADDY_ACME_DOMAIN=railbloc-api.duckdns.org

# ── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_USER=rail_admin
🔧 POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=railbloc_db
DATABASE_URL=postgresql+asyncpg://rail_admin:CHANGE_ME_strong_password@postgres:5432/railbloc_db
DATABASE_URL_SYNC=postgresql+psycopg2://rail_admin:CHANGE_ME_strong_password@postgres:5432/railbloc_db

# ── Redis ────────────────────────────────────────────────────────────────
🔧 REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_URL=redis://:CHANGE_ME_strong_redis_password@redis:6379/0

# ── Auth ─────────────────────────────────────────────────────────────────
🔧 JWT_SECRET=openssl_rand_hex_32_generate_karo
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Machine-feed credentials (ingest auth) ──────────────────────────────
🔧 INGEST_KEY_TMS=openssl_rand_hex_generate
🔧 INGEST_KEY_TDMS=openssl_rand_hex_generate
🔧 INGEST_KEY_SMMS=openssl_rand_hex_generate
🔧 INGEST_KEY_FOIS=openssl_rand_hex_generate

# ── External integrations ───────────────────────────────────────────────
IMD_API_KEY=mock_imd_weather_key_railway_ops
🔧 COA_BRIDGE_SECRET=openssl_rand_hex_generate

# ── Solver / cadence ────────────────────────────────────────────────────
SOLVER_MAX_TIME_SECONDS=35
SOLVER_NUM_WORKERS=4
MONTHLY_PLAN_CRON=0 6 1 * *

# ── Demo credentials (login personas) ───────────────────────────────────
# Judges ko ye password dena hai (login persona grid ke liye)
🔧 SEED_PASSWORD=choose_demo_password
